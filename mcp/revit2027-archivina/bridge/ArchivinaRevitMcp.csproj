<Project Sdk="Microsoft.NET.Sdk">
  <!-- Add-in Revit 2027 (.NET 10): cầu TCP 127.0.0.1 cho MCP server "revit2027-archivina". Biên dịch: ..\build.ps1 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ArchivinaRevitMcp</AssemblyName>
    <RootNamespace>ArchivinaRevitMcp</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RevitDir Condition="'$(RevitDir)' == ''">D:\Archivina Revit\Revit 2027</RevitDir>
    <Version>1.0.0</Version>
    <!-- RevitAPI tham chiếu Microsoft.VisualBasic 10.1 (runtime Revit có sẵn) – cảnh báo vô hại -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
